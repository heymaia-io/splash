    {
      "label": "Per-backend GPU enumeration build options",
      "file_type": "rationale",
      "source_file": "kotlin/komelia-infra/onnxruntime/native/CMakeLists.txt",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
